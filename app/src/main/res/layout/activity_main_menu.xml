<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient">

    <com.lava.floorislava.LavaBackgroundView
        android:id="@+id/lavaBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="48dp"
            android:paddingEnd="24dp"
            android:paddingBottom="140dp">

            <TextView
                android:id="@+id/menuEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌋"
                android:textSize="52sp" />

            <TextView
                android:id="@+id/menuTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:shadowColor="@color/lava_red"
                android:shadowRadius="18"
                android:text="FLOOR IS\nLAVA"
                android:textColor="@color/lava_gold"
                android:textSize="44sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:letterSpacing="0.3"
                android:text="@string/menu_tagline"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/playButton"
                android:layout_width="168dp"
                android:layout_height="168dp"
                android:layout_marginTop="26dp"
                android:background="@drawable/selector_start_button"
                android:clickable="true"
                android:contentDescription="@string/menu_play"
                android:elevation="10dp"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.08"
                    android:text="@string/menu_play"
                    android:textColor="@color/lava_black"
                    android:textSize="26sp" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:letterSpacing="0.2"
                android:text="@string/menu_difficulty"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_mode_toggle_track"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/difficultyEasy"
                    style="@style/DifficultyPill"
                    android:text="EASY" />

                <TextView
                    android:id="@+id/difficultyNormal"
                    style="@style/DifficultyPill"
                    android:text="NORMAL" />

                <TextView
                    android:id="@+id/difficultyHard"
                    style="@style/DifficultyPill"
                    android:text="HARD" />
            </LinearLayout>

            <TextView
                android:id="@+id/difficultySummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/lava_yellow"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.2"
                    android:text="@string/menu_record"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/StatColumn">
                        <TextView android:id="@+id/statWins" style="@style/StatValue" />
                        <TextView style="@style/StatLabel" android:text="@string/stat_wins" />
                    </LinearLayout>

                    <LinearLayout style="@style/StatColumn">
                        <TextView android:id="@+id/statWinRate" style="@style/StatValue" />
                        <TextView style="@style/StatLabel" android:text="@string/stat_win_rate" />
                    </LinearLayout>

                    <LinearLayout style="@style/StatColumn">
                        <TextView android:id="@+id/statBestStreak" style="@style/StatValue" />
                        <TextView style="@style/StatLabel" android:text="@string/stat_best_streak" />
                    </LinearLayout>

                    <LinearLayout style="@style/StatColumn">
                        <TextView android:id="@+id/statBestTime" style="@style/StatValue" />
                        <TextView style="@style/StatLabel" android:text="@string/stat_fastest" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/howToPlayButton"
                    style="@style/PillButton"
                    android:layout_marginEnd="6dp"
                    android:text="@string/menu_how_to_play" />

                <TextView
                    android:id="@+id/hapticsButton"
                    style="@style/PillButton"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
